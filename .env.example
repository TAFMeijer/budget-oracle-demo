# Budget Oracle (demo) — public Global Fund grant budgets, asked in plain English.
# Copy to .env. Build the data file once:  python data/build_gf_budgets.py  (see README)

# --- data: a local SQLite file built from the public Data Service API -------------------------
DB_URL=sqlite:///file:data/gf_budgets.sqlite?mode=ro&uri=true
ALLOWED_TABLES=grant_budgets
HIERARCHIES=module>intervention,investment_landscape_1>investment_landscape_2,continent>subcontinent
REQUIRED_FILTERS=grant_budgets:grant_cycle|year     # every query says which cycles or years it covers
VALID_VALUES_EXCLUDE=grant_budgets:period_start,period_end,grant_type   # dates are no value list; grant_type's values are in the notes, kept away from component's
VALID_VALUES_MAX=150                # lists countries (137), modules, cost categories for the model and the guard
ROW_LIMIT=2000
PROMPT_NOTES=notes.md
USER_GUIDE=guide.md
EXAMPLE_QUESTIONS=examples.txt
APP_TITLE=Budget Oracle (demo)

# --- language model: any OpenAI-compatible endpoint; LM Studio or Ollama keep it local --------
LLM_PROVIDER=openai
OPENAI_BASE_URL=http://localhost:1234/v1
LLM_MODEL=google/gemma-4-26b-a4b-qat
LLM_REASONING_EFFORT=on
LLM_MAX_TOKENS=8000                 # must cover the model's reasoning as well as the answer
ENABLE_OBSERVATIONS=false           # no second model call over result rows
CONVERSATION_HISTORY=true
CONTEXT_WINDOW=32768                # the context length your model server is loaded with
CONTEXT_RESERVE=0

# --- a public deployment: nothing of the inner workings, and bounded cost ----------------------
SHOW_SQL=false                      # no SQL, no technical details, no raw error text in the UI
MAX_QUESTION_CHARS=600
QUESTIONS_PER_IP=20                 # per QUESTIONS_WINDOW seconds, per visitor address
QUESTIONS_GLOBAL=300                # per QUESTIONS_WINDOW, everyone together
QUESTIONS_WINDOW=3600
MAX_CONCURRENT_QUESTIONS=2          # answers being written at the same time
DB_QUERY_TIMEOUT=15                 # seconds before a query is interrupted
SQLITE_HEAP_LIMIT_MB=512
AUDIT_LOG=logs/audit.jsonl          # questions and outcomes, no visitor identifiers
